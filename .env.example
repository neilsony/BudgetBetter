# Copy to .env and fill in. .env is gitignored — never commit it.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox | production
PLAID_ENV=sandbox

# Fernet key used to encrypt Item access tokens at rest.
# Generate one with:  python -m budgetbetter.crypto keygen
APP_ENCRYPTION_KEY=

# Where the local SQLite database lives.
BUDGETBETTER_DB=budgetbetter.db
